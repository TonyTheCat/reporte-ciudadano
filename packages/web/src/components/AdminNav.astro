---
const { active } = Astro.props as { active: "bandeja" | "moderacion" | "categorias" };
const items = [
  { key: "bandeja", href: "/admin", label: "Bandeja" },
  { key: "moderacion", href: "/admin/moderacion", label: "Moderación" },
  { key: "categorias", href: "/admin/categorias", label: "Categorías" },
  { key: "gis", href: "/estadisticas", label: "Consultas GIS" },
];
---
<nav class="mb-4 flex gap-1 overflow-x-auto" aria-label="Administración">
  {items.map((i) => (
    <a href={i.href} class:list={["shrink-0 rounded-lg px-3 py-2 text-sm font-semibold", active === i.key ? "bg-brand-600 text-white" : "bg-surface text-fg-muted ring-1 ring-line"]}>{i.label}</a>
  ))}
</nav>
