---
interface Props {
  label?: string;
  name?: string;
  /** Contraseña nueva: autocompletado "new-password" e indicador de largo mínimo. */
  isNew?: boolean;
  autofocus?: boolean;
  aside?: { href: string; label: string };
}

const { label = "Contraseña", name = "password", isNew = false, autofocus, aside } = Astro.props;
const id = `f-${name}`;
---
<div>
  <div class="mb-1.5 flex items-baseline justify-between gap-3">
    <label class="label mb-0" for={id}>{label}</label>
    {aside && <a class="text-sm font-semibold text-brand-700 hover:underline" href={aside.href}>{aside.label}</a>}
  </div>
  <div class="relative">
    <input
      class="input pr-24"
      id={id}
      name={name}
      type="password"
      required
      minlength={8}
      autocomplete={isNew ? "new-password" : "current-password"}
      autofocus={autofocus}
      aria-describedby={isNew ? `${id}-hint` : undefined}
      data-min-hint={isNew ? `${id}-hint` : undefined}
    />
    <button
      type="button"
      class="absolute inset-y-1.5 right-1.5 rounded-lg px-3 text-sm font-semibold text-slate-600 hover:bg-sand-100 hover:text-ink focus-visible:outline-2 focus-visible:outline-brand-500"
      data-toggle-password={id}
      aria-controls={id}
    >Mostrar</button>
  </div>
  {isNew && (
    <p id={`${id}-hint`} class="mt-2 flex items-center gap-2 text-sm text-slate-500">
      <span class="rc-check inline-flex h-4 w-4 items-center justify-center rounded-full border border-sand-300 text-[10px] leading-none" aria-hidden="true">✓</span>
      Mínimo 8 caracteres. Una frase corta es más segura y fácil de recordar.
    </p>
  )}
</div>
