---
import type { Summary } from "@rc/core/stats";
import { STATUS_COLOR, STATUS_LABEL, type Status } from "@rc/core/status";
import { formatNumber, pct } from "../lib/format";

interface Props {
  summary: Summary;
  timeseries?: { week: Date; created: number; resolved: number }[];
  categoryHref?: (slug: string) => string;
}
const { summary: s, timeseries = [], categoryHref } = Astro.props;
const maxCat = Math.max(1, ...s.by_category.map((c) => c.n));

// Serie semanal: barras de creados y línea de resueltos.
const W = 600, H = 140, P = 4;
const maxT = Math.max(1, ...timeseries.map((t) => Math.max(t.created, t.resolved)));
const bw = timeseries.length ? (W - P * 2) / timeseries.length : 0;
const y = (v: number) => H - P - (v / maxT) * (H - P * 2);
const line = timeseries.map((t, i) => `${i ? "L" : "M"}${(P + bw * i + bw / 2).toFixed(1)},${y(t.resolved).toFixed(1)}`).join(" ");
---
<div class="space-y-4">
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="card p-4"><p class="text-3xl font-extrabold">{formatNumber(s.total)}</p><p class="text-sm text-fg-subtle">reportes</p></div>
    <div class="card p-4"><p class="text-3xl font-extrabold text-alert-fg">{formatNumber(s.open)}</p><p class="text-sm text-fg-subtle">abiertos</p></div>
    <div class="card p-4"><p class="text-3xl font-extrabold text-success">{pct(s.resolution_rate)}</p><p class="text-sm text-fg-subtle">resueltos</p></div>
    <div class="card p-4"><p class="text-3xl font-extrabold">{s.median_days_to_resolve ?? "—"}</p><p class="text-sm text-fg-subtle">días para resolver (mediana)</p></div>
  </div>

  {s.by_category.length > 0 && (
    <div class="card p-4">
      <h3 class="mb-3 font-bold">Por categoría</h3>
      <ul class="space-y-2">
        {s.by_category.map((c) => (
          <li>
            <a href={categoryHref?.(c.slug)} class="block">
              <div class="mb-0.5 flex justify-between text-sm"><span>{c.icon} {c.name}</span><span class="font-semibold">{c.n} <span class="font-normal text-fg-subtle">· {c.resolved} resueltos</span></span></div>
              <div class="h-2.5 overflow-hidden rounded-full bg-fill">
                <div class="h-full rounded-full" style={`width:${(c.n / maxCat) * 100}%;background:${c.color}`}></div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  {timeseries.length > 0 && (
    <div class="card p-4">
      <h3 class="mb-1 font-bold">Últimos 6 meses</h3>
      <p class="mb-2 flex gap-4 text-xs text-fg-subtle">
        <span><span class="mr-1 inline-block h-2 w-3 rounded-sm bg-brand-500"></span>Reportados por semana</span>
        <span><span class="mr-1 inline-block h-0.5 w-3 bg-success-solid align-middle"></span>Resueltos</span>
      </p>
      <svg viewBox={`0 0 ${W} ${H}`} class="h-36 w-full" role="img" aria-label="Reportes creados y resueltos por semana">
        {timeseries.map((t, i) => (
          <rect x={P + bw * i + 1} y={y(t.created)} width={Math.max(1, bw - 2)} height={H - P - y(t.created)} rx="2" fill="#1a856a" opacity="0.8">
            <title>{`Semana del ${t.week.toISOString().slice(0, 10)}: ${t.created} reportados, ${t.resolved} resueltos`}</title>
          </rect>
        ))}
        <path d={line} fill="none" stroke="#2f9e44" stroke-width="2.5" stroke-linejoin="round" />
      </svg>
    </div>
  )}

  {s.by_status.length > 0 && (
    <p class="flex flex-wrap gap-2 text-sm">
      {s.by_status.map((b) => (
        <span class="chip tint" style={`--tint:${STATUS_COLOR[b.status as Status]}`}>{STATUS_LABEL[b.status as Status]}: {b.n}</span>
      ))}
    </p>
  )}
</div>
