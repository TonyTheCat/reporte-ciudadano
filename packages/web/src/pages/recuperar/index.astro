---
import Field from "../../components/auth/Field.astro";
import Notice from "../../components/auth/Notice.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { safeNext } from "../../lib/server/auth";
import { forgotPassword } from "../../lib/server/cognito";
import { allow, errorMessage, field, isEmail, keepNext, postedForm, qs } from "../../lib/server/forms";

let next = safeNext(Astro.url.searchParams.get("next"));
let email = Astro.url.searchParams.get("email") ?? "";
let error: string | undefined;
let emailError: string | undefined;

try {
  const form = await postedForm(Astro);
  if (form) {
    email = field(form, "email");
    next = safeNext(field(form, "next"));
    if (!isEmail(email)) {
      emailError = "Escribí un correo válido, por ejemplo nombre@correo.com.";
      Astro.response.status = 400;
    } else {
      await allow(Astro, "forgot", 5, 3600);
      // Con preventUserExistenceErrors, Cognito responde igual exista o no la cuenta.
      await forgotPassword(email);
      return Astro.redirect(`/recuperar/nueva${qs({ email, next: keepNext(next) })}`);
    }
  }
} catch (err) {
  error = errorMessage(err);
  Astro.response.status = 400;
}
---
<AuthLayout title="Recuperar contraseña" heading="¿Olvidaste tu contraseña?" lead="Escribí el correo de tu cuenta y te enviamos un código para crear una nueva.">
  {error && <Notice tone="error">{error}</Notice>}
  <form method="post" class="space-y-5" data-auth>
    <input type="hidden" name="next" value={next} />
    <Field label="Correo electrónico" name="email" type="email" value={email} required autocomplete="email" inputmode="email" placeholder="nombre@correo.com" error={emailError} autofocus />
    <button type="submit" class="btn-primary w-full text-[1.0625rem]">Enviarme el código</button>
  </form>
  <p class="mt-8 text-center text-[0.9375rem] text-fg-muted">
    ¿Te acordaste?
    <a class="font-semibold text-accent hover:underline" href={`/ingresar${qs({ email: email || undefined, next: keepNext(next) })}`}>Volver a ingresar</a>
  </p>
</AuthLayout>
