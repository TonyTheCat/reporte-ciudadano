---
import { getDepartment } from "@rc/core/areas";
import { getCategoryBySlug } from "@rc/core/categories";
import { listReports } from "@rc/core/reports";
import { countsByArea, summary, timeseries } from "@rc/core/stats";
import StatsMap from "../../components/islands/StatsMap";
import ReportList from "../../components/ReportList.astro";
import StatsBlock from "../../components/StatsBlock.astro";
import Base from "../../layouts/Base.astro";

const category = await getCategoryBySlug(Astro.params.slug!);
if (!category) return Astro.rewrite("/404");
const deptSlug = Astro.url.searchParams.get("dept") ?? undefined;
const dept = deptSlug ? await getDepartment(deptSlug) : undefined;
const scope = { category: category.slug, deptId: dept?.id };
const [s, ts, recent, byDept] = await Promise.all([
  summary(scope), timeseries(scope, 26), listReports({ category: category.slug, deptSlug: dept?.slug, limit: 30 }), countsByArea(1, { category: category.slug }),
]);
const where = dept ? ` en ${dept.name}` : " en Paraguay";
---
<Base title={`${category.name}${where}`} description={`${category.description ?? category.name}. ${s.total} reportes${where}: ${s.open} abiertos y ${s.resolved} resueltos.`}>
  <div class="mx-auto max-w-5xl space-y-6 px-4 py-6">
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-4xl" aria-hidden="true">{category.icon}</p>
        <h1 class="text-3xl font-extrabold">{category.name}{where}</h1>
        {category.description && <p class="text-fg-muted">{category.description}</p>}
        {!category.accepting && <p class="mt-2 chip bg-fill text-fg-muted">Esta categoría no recibe reportes nuevos en este momento.</p>}
      </div>
      {category.accepting && <a href={`/reportar?categoria=${category.slug}`} class="btn-alert py-2 text-sm">+ Reportar {category.name.toLowerCase()}</a>}
    </header>
    <StatsBlock summary={s} timeseries={ts} />
    {!dept && (
      <section>
        <h2 class="mb-2 text-xl font-bold">Por departamento</h2>
        <StatsMap client:visible level={1} category={category.slug} />
        <ul class="mt-3 flex flex-wrap gap-2 text-sm">
          {byDept.filter((d) => d.total > 0).map((d) => <li><a class="chip bg-surface px-3 py-1.5 ring-1 ring-line" href={`?dept=${d.slug}`}>{d.name} · {d.total}</a></li>)}
        </ul>
      </section>
    )}
    <section>
      <h2 class="mb-2 text-xl font-bold">Últimos reportes</h2>
      <ReportList reports={recent} empty="Todavía no hay reportes en esta categoría." />
    </section>
  </div>
</Base>
