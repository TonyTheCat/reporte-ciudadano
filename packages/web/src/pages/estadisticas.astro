---
import { listCategories } from "@rc/core/categories";
import { countsByArea, hotspots, summary, timeseries } from "@rc/core/stats";
import GisQuery from "../components/islands/GisQuery";
import StatsMap from "../components/islands/StatsMap";
import StatsBlock from "../components/StatsBlock.astro";
import Base from "../layouts/Base.astro";

const [s, ts, spots, byDept, categories] = await Promise.all([summary(), timeseries({}, 26), hotspots({}, 250, 3, 30), countsByArea(1), listCategories()]);
const ranked = byDept.filter((d) => d.total > 0);
---
<Base title="Estadísticas y mapa de problemas urbanos" description="Estadísticas abiertas de los problemas urbanos reportados en Paraguay: por departamento, categoría, focos críticos y tiempos de resolución." active="estadisticas">
  <div class="mx-auto max-w-6xl space-y-8 px-4 py-6">
    <header>
      <h1 class="text-3xl font-extrabold">Estadísticas</h1>
      <p class="text-fg-muted">Todo lo que la ciudadanía reportó, en números. Los datos son abiertos: <a class="font-semibold text-accent underline" href="/datos-abiertos">descargalos</a>.</p>
    </header>

    <StatsBlock summary={s} timeseries={ts} categoryHref={(slug) => `/categoria/${slug}`} />

    <section class="grid gap-4 lg:grid-cols-[1fr_20rem]">
      <div>
        <h2 class="mb-2 text-xl font-bold">Mapa por departamento y focos críticos</h2>
        <StatsMap client:visible level={1} hotspots={spots} height="28rem" />
      </div>
      <div>
        <h2 class="mb-2 text-xl font-bold">Ranking</h2>
        <ol class="card divide-y divide-line text-sm">
          {ranked.slice(0, 18).map((d, i) => (
            <li><a href={`/py/${d.slug}`} class="flex justify-between p-3 hover:bg-surface-2"><span><b class="mr-2 text-fg-subtle">{i + 1}</b>{d.name}</span><span>{d.total} <span class="text-fg-subtle">· {d.total ? Math.round((d.resolved / d.total) * 100) : 0}% resuelto</span></span></a></li>
          ))}
          {ranked.length === 0 && <li class="p-3 text-fg-subtle">Sin datos todavía.</li>}
        </ol>
      </div>
    </section>

    <section>
      <h2 class="mb-1 text-xl font-bold">Consultá cualquier zona</h2>
      <p class="mb-3 text-fg-muted">Dibujá un área (tu barrio, una avenida, un radio alrededor de una escuela) y obtené sus estadísticas y focos.</p>
      <GisQuery client:visible categories={categories.map(({ slug, name }) => ({ slug, name }))} />
    </section>
  </div>
</Base>
