---
import { getDepartment, getDistrict } from "@rc/core/areas";
import { listReports } from "@rc/core/reports";
import { hotspots, summary, timeseries } from "@rc/core/stats";
import StatsMap from "../../../components/islands/StatsMap";
import ReportList from "../../../components/ReportList.astro";
import StatsBlock from "../../../components/StatsBlock.astro";
import Base from "../../../layouts/Base.astro";

const district = await getDistrict(Astro.params.dept!, Astro.params.district!);
if (!district) return Astro.rewrite("/404");
const scope = { districtId: district.id };
const [dept, s, ts, spots, open, resolved] = await Promise.all([
  getDepartment(Astro.params.dept!), summary(scope), timeseries(scope, 26), hotspots(scope, 150, 2),
  listReports({ districtSlug: district.slug, deptSlug: Astro.params.dept, status: "abiertos", limit: 30 }),
  listReports({ districtSlug: district.slug, deptSlug: Astro.params.dept, status: "resuelto", limit: 10 }),
]);
---
<Base title={`Reportes en ${district.name}, ${dept?.name}`} description={`${s.total} problemas reportados en ${district.name} (${dept?.name}): ${s.open} abiertos, ${s.resolved} resueltos. Mirá el mapa y seguí cada caso.`} active="zonas">
  <div class="mx-auto max-w-5xl space-y-6 px-4 py-6">
    <nav class="text-sm text-fg-subtle"><a href="/py" class="hover:underline">Paraguay</a> › <a href={`/py/${Astro.params.dept}`} class="hover:underline">{dept?.name}</a> › {district.name}</nav>
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-extrabold">{district.name}</h1>
        <p class="text-fg-muted">{dept?.name}, Paraguay</p>
      </div>
      <div class="flex gap-2">
        <a href={`/?lat=${(district.bbox[1] + district.bbox[3]) / 2}&lng=${(district.bbox[0] + district.bbox[2]) / 2}&z=13`} class="btn-ghost py-2 text-sm">Ver en el mapa</a>
        <a href="/reportar" class="btn-alert py-2 text-sm">+ Reportar</a>
      </div>
    </header>
    <StatsBlock summary={s} timeseries={ts} categoryHref={(slug) => `/categoria/${slug}`} />
    {spots.length > 0 && (
      <section>
        <h2 class="mb-2 text-xl font-bold">Focos con más problemas abiertos</h2>
        <StatsMap client:visible level={2} dept={district.parent_id ?? undefined} deptSlug={Astro.params.dept} bbox={district.bbox} hotspots={spots} height="20rem" />
      </section>
    )}
    <section>
      <h2 class="mb-2 text-xl font-bold">Reportes abiertos</h2>
      <ReportList reports={open} empty={`No hay reportes abiertos en ${district.name}.`} />
    </section>
    {resolved.length > 0 && (
      <section>
        <h2 class="mb-2 text-xl font-bold">Resueltos recientemente</h2>
        <ReportList reports={resolved} />
      </section>
    )}
  </div>
</Base>
