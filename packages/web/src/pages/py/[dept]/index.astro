---
import { getDepartment, listChildren } from "@rc/core/areas";
import { listReports } from "@rc/core/reports";
import { countsByArea, hotspots, summary, timeseries } from "@rc/core/stats";
import StatsMap from "../../../components/islands/StatsMap";
import ReportList from "../../../components/ReportList.astro";
import StatsBlock from "../../../components/StatsBlock.astro";
import Base from "../../../layouts/Base.astro";

const dept = await getDepartment(Astro.params.dept!);
if (!dept) return Astro.rewrite("/404");
const scope = { deptId: dept.id };
const [districts, counts, s, ts, spots, recent] = await Promise.all([
  listChildren(dept.id), countsByArea(2, scope), summary(scope), timeseries(scope, 26), hotspots(scope), listReports({ deptSlug: dept.slug, limit: 20 }),
]);
const byId = new Map(counts.map((c) => [c.area_id, c]));
const title = dept.slug === "asuncion" ? "Asunción" : `Departamento de ${dept.name}`;
---
<Base title={`Reportes en ${title}`} description={`${s.total} problemas urbanos reportados en ${title}: ${s.open} abiertos y ${s.resolved} resueltos. Baches, raudales, basura, inseguridad y más.`} active="zonas">
  <div class="mx-auto max-w-5xl space-y-6 px-4 py-6">
    <nav class="text-sm text-fg-subtle"><a href="/py" class="hover:underline">Paraguay</a> › {dept.name}</nav>
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-extrabold">{title}</h1>
        <p class="text-fg-muted">Problemas reportados por la ciudadanía y su estado.</p>
      </div>
      <a href={`/?lat=${(dept.bbox[1] + dept.bbox[3]) / 2}&lng=${(dept.bbox[0] + dept.bbox[2]) / 2}&z=9`} class="btn-ghost py-2 text-sm">Ver en el mapa</a>
    </header>
    <StatsBlock summary={s} timeseries={ts} categoryHref={(slug) => `/categoria/${slug}?dept=${dept.slug}`} />
    <section>
      <h2 class="mb-2 text-xl font-bold">Distritos</h2>
      <StatsMap client:visible level={2} dept={dept.id} deptSlug={dept.slug} bbox={dept.bbox} hotspots={spots} />
      <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {districts.map((d) => {
          const c = byId.get(d.id);
          return (
            <li><a href={`/py/${dept.slug}/${d.slug}`} class="card flex justify-between p-3 text-sm hover:ring-brand-500"><span class="font-semibold">{d.name}</span><span class="text-fg-subtle">{c?.total ?? 0} · <span class="text-alert-fg">{c?.open ?? 0} abiertos</span></span></a></li>
          );
        })}
      </ul>
    </section>
    <section>
      <h2 class="mb-2 text-xl font-bold">Últimos reportes</h2>
      <ReportList reports={recent} empty={`Todavía no hay reportes en ${dept.name}. ¡Sé la primera persona en reportar!`} />
    </section>
  </div>
</Base>
